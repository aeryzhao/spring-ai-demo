<?xml version="1.0" encoding="UTF-8"?>
<!--
  langchain4j 模块专用 Maven 配置（当前环境的构建配置）。

  为什么需要它：
    1. 本机全局 settings.xml 把 localRepository 指向 /Users/codance/repo/mvn，
       该目录在工作区之外，当前沙箱无法写入，Maven 无法缓存新下载的依赖；
    2. 全局 settings.xml 里配置了若干公司内网 Nexus（10.91.0.104 / 10.91.0.105），
       在当前网络下不可达，每个依赖都要先等它们超时，构建极慢。

  因此这里把依赖缓存改到模块内的 .m2-repo，并只保留可达的阿里云镜像。

  用法（在 langchain4j 目录下执行）：
      mvn -s settings.xml compile
      mvn -s settings.xml spring-boot:run

  说明：
    - .m2-repo 已在 .gitignore 中忽略，不会提交；
    - 如果你的网络能访问公司内网 Nexus，直接用全局 settings.xml（即不带 -s 参数）也可以；
    - 换到自己的机器/CI 时，本文件可直接删除。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- 依赖缓存放到模块内，避免写入工作区之外的目录 -->
    <localRepository>${user.dir}/.m2-repo</localRepository>

    <mirrors>
        <!-- 用阿里云镜像统一代理 central，避免走不可达的内网仓库 -->
        <mirror>
            <id>alimaven</id>
            <name>Aliyun Maven Central</name>
            <url>https://maven.aliyun.com/repository/central</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>reachable-repos</id>
            <!-- 只声明可达的仓库，覆盖全局 settings 里的内网仓库列表 -->
            <repositories>
                <repository>
                    <id>aliyun-public</id>
                    <name>Aliyun Public</name>
                    <url>https://maven.aliyun.com/repository/public</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>aliyun-public</id>
                    <name>Aliyun Public</name>
                    <url>https://maven.aliyun.com/repository/public</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>reachable-repos</activeProfile>
    </activeProfiles>

</settings>
